{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "control-center-positionX": "right",
  "control-center-positionY": "none",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "control-center-width": 430,
  "control-center-height": 780,
  "control-center-layer": "overlay",
  "control-center-exclusive-zone": true,
  "layer": "overlay",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 44,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 0,
  "timeout-low": 0,
  "timeout-critical": 0,
  "notification-window-width": 400,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 250,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": false,
  "scripts": {
    "dynamic-pill": {
      "app-name": ".*",
      "exec": "/usr/bin/python3 @HOME@/.config/hypr/scripts/tools/notif"
    }
  },
  "notification-visibility": {
    "mute-all": {
      "state": "muted",
      "app-name": ".*"
    }
  },
  "widgets": [
    "title#quicksettings",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "title#notifications",
    "notifications"
  ],
  "widget-config": {
    "title#quicksettings": {
      "text": "Quick Settings",
      "clear-all-button": false
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰖩   Wi-Fi",
          "type": "toggle",
          "active": true,
          "command": "[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off",
          "update_command": "[[ $(nmcli radio wifi) == enabled ]] && echo true || echo false"
        },
        {
          "label": "󰂯   Bluetooth",
          "type": "toggle",
          "active": true,
          "command": "[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off",
          "update_command": "bluetoothctl show | grep -q 'Powered: yes' && echo true || echo false"
        },
        {
          "label": "󰂛   DND",
          "type": "toggle",
          "active": false,
          "command": "[[ $SWAYNC_TOGGLE_STATE == true ]] && swaync-client -dn -sw || swaync-client -df -sw",
          "update_command": "swaync-client -D -sw"
        },
        {
          "label": "󰖔   Night Light",
          "type": "toggle",
          "active": false,
          "command": "pkill -x gammastep; if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then nohup gammastep -O 4500 >/dev/null 2>&1 & fi",
          "update_command": "pgrep -x gammastep >/dev/null && echo true || echo false"
        },
        {
          "label": "󰓅   Performance",
          "type": "toggle",
          "active": false,
          "command": "if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then env PATH=/usr/bin /usr/bin/powerprofilesctl set performance; else env PATH=/usr/bin /usr/bin/powerprofilesctl set balanced; fi",
          "update_command": "[ \"$(env PATH=/usr/bin /usr/bin/powerprofilesctl get)\" = performance ] && echo true || echo false"
        },
        {
          "label": "󰖂   VPN",
          "command": "setsid -f protonvpn-app >/dev/null 2>&1"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "expand-per-app": false,
      "empty-list-label": "No audio apps",
      "expand-button-label": "󰅃",
      "collapse-button-label": "󰅀"
    },
    "backlight": {
      "label": "󰃠",
      "device": "nvidia_0",
      "subsystem": "backlight",
      "min": 5
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 12,
      "show-album-art": "always",
      "autohide": true,
      "blacklist": [
        "playerctld"
      ],
      "loop-carousel": true
    },
    "title#notifications": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
